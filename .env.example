# Clerk (use the SAME Clerk application as the main ChatCoat web app —
# the backend verifies the session token, so staff sign in with their
# existing ChatCoat identity; no separate user database needed).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ChatCoat API base URL. Defaults to the production Render API when unset
# on a non-localhost deployment.
NEXT_PUBLIC_API_URL=https://social-automation-api-8a9h.onrender.com
